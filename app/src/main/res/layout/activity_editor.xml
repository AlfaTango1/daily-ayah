<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/editorTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:text="@string/editor_title_widget"
        android:textColor="@color/primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Live preview, always visible above the settings. -->
    <FrameLayout
        android:id="@+id/previewFrame"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/preview_wallpaper"
        android:padding="12dp">

        <ImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">

            <!-- Ready-made styles -->
            <TextView style="@style/EditorLabel" android:text="@string/presets_label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/presetGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="false"
                app:singleSelection="false" />

            <!-- Content -->
            <TextView style="@style/EditorLabel" android:text="@string/content" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/contentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBoth"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/content_both" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipArabic"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/content_arabic" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTranslation"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/content_translation" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCustom"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/content_custom" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/customTextLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/custom_text_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/customText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="6"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Translation -->
            <TextView style="@style/EditorLabel" android:text="@string/translation" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/translationGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/trUzLatn"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_uz_latn" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/trUzCyrl"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_uz_cyrl" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/trRu"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_ru" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/trEn"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_en" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/translations_hint"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- Fonts -->
            <TextView style="@style/EditorLabel" android:text="@string/arabic_font" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/arabicFontGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView style="@style/EditorLabel" android:text="@string/text_font" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/textFontGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <!-- Sizes -->
            <TextView
                android:id="@+id/arabicSizeLabel"
                style="@style/EditorLabel"
                android:text="@string/arabic_size" />

            <com.google.android.material.slider.Slider
                android:id="@+id/arabicSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:valueFrom="12"
                android:valueTo="44" />

            <TextView
                android:id="@+id/textSizeLabel"
                style="@style/EditorLabel"
                android:text="@string/text_size" />

            <com.google.android.material.slider.Slider
                android:id="@+id/textSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:valueFrom="9"
                android:valueTo="30" />

            <TextView
                android:id="@+id/lineSpacingLabel"
                style="@style/EditorLabel"
                android:text="@string/line_spacing" />

            <com.google.android.material.slider.Slider
                android:id="@+id/lineSpacing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:valueFrom="70"
                android:valueTo="200" />

            <!-- Style -->
            <TextView style="@style/EditorLabel" android:text="@string/text_style_section" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/italic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/italic" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/showSurah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_surah" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/showReference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_reference" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/shadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shadow" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/ayahMark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ayah_mark" />

            <TextView style="@style/EditorLabel" android:text="@string/alignment" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/alignGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/alStart"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/align_start" />

                <Button
                    android:id="@+id/alCenter"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/align_center" />

                <Button
                    android:id="@+id/alEnd"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/align_end" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Colours -->
            <TextView style="@style/EditorLabel" android:text="@string/colours" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/themeRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp" />
            </HorizontalScrollView>

            <TextView style="@style/EditorLabel" android:text="@string/pattern" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/patternGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/patternIntensityLabel"
                style="@style/EditorLabel"
                android:text="@string/pattern_intensity" />

            <com.google.android.material.slider.Slider
                android:id="@+id/patternIntensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="2"
                android:valueFrom="4"
                android:valueTo="80" />

            <TextView style="@style/EditorLabel" android:text="@string/frame" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/frameGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />


            <TextView
                android:id="@+id/opacityLabel"
                style="@style/EditorLabel"
                android:text="@string/opacity" />

            <com.google.android.material.slider.Slider
                android:id="@+id/opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:valueFrom="0"
                android:valueTo="100" />

            <TextView
                android:id="@+id/cornerLabel"
                style="@style/EditorLabel"
                android:text="@string/corners" />

            <com.google.android.material.slider.Slider
                android:id="@+id/corner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="2"
                android:valueFrom="0"
                android:valueTo="40" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <Button
            android:id="@+id/btnReset"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
